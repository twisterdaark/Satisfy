{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$world": {
        ".validate": "$world === 'satisfy'",
        "$shard": {
          ".read": "auth != null",
          ".indexOn": ["x", "party"],
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['v', 'uid', 'sid', 'handle', 'look', 'cls', 'lv', 'zone', 'x', 'y', 'dir', 'anim', 'arm', 'seq', 't'])",
            "v": {
              ".validate": "newData.val() === 1"
            },
            "uid": {
              ".validate": "newData.val() === $uid"
            },
            "sid": {
              ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
            },
            "handle": {
              ".validate": "newData.isString() && newData.val().length <= 24 && newData.val() === root.child('accountIds').child($uid).val()"
            },
            "look": {
              ".validate": "newData.hasChildren(['hair', 'hc', 'skin', 'top'])",
              "$f": {
                ".validate": "($f === 'hair' || $f === 'hc' || $f === 'skin' || $f === 'top') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 31"
              }
            },
            "cls": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "lv": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999"
            },
            "title": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "zone": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "room": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "x": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 16384"
            },
            "y": {
              ".validate": "newData.isNumber() && newData.val() >= -2048 && newData.val() < 4096"
            },
            "dir": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
            },
            "anim": {
              ".validate": "newData.isString() && newData.val().matches(/^(idle|walk|attack|dodge|dead)$/)"
            },
            "arm": {
              ".validate": "newData.val() === 0 || newData.val() === 1"
            },
            "party": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "duel": {
              ".validate": "newData.isString() && newData.val().matches(/^d_[A-Za-z0-9_-]{1,40}:(100|[1-9]?[0-9])$/)"
            },
            "mv": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{8}$/)"
            },
            "hp": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "em": {
              ".validate": "newData.isString() && newData.val().matches(/^(wave|dance|point|cheer)$/)"
            },
            "role": {
              ".validate": "newData.isString() && newData.val().matches(/^(tank|healer|damage|support)$/)"
            },
            "wp": {
              ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_]{1,16}:[0-9]$/)"
            },
            "seq": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },
            "t": {
              ".validate": "newData.val() === now"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$msg": {
          ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (!data.exists() && newData.child('from').val() === auth.uid))",
          ".validate": "newData.hasChildren(['from', 'sid', 'seq', 'type', 'payload', 't'])",
          "from": {
            ".validate": "newData.isString() && newData.val().length <= 128"
          },
          "sid": {
            ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
          },
          "seq": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().matches(/^(party\\.(invite|accept|decline|kick|ping)|duel\\.(challenge|accept|decline|ready|hit|hp|yield|end)|raid\\.(hit|state|kill)|chat\\.(say))$/)"
          },
          "payload": {
            ".validate": "newData.hasChild('to') && ((newData.parent().child('type').val().beginsWith('party.') && newData.hasChild('party') && !newData.hasChild('duel') && !newData.hasChild('text')) || (newData.parent().child('type').val().beginsWith('duel.') && newData.hasChild('duel') && !newData.hasChild('party') && !newData.hasChild('text')) || (newData.parent().child('type').val().beginsWith('raid.') && newData.hasChild('raid') && !newData.hasChild('party') && !newData.hasChild('duel') && !newData.hasChild('text')) || (newData.parent().child('type').val().beginsWith('chat.') && newData.hasChildren(['party', 'text']) && !newData.hasChild('duel') && !newData.hasChild('raid') && !newData.hasChild('k') && !newData.hasChild('n')))",
            "to": {
              ".validate": "newData.val() === $uid"
            },
            "party": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "duel": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "k": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
            },
            "n": {
              ".validate": "newData.isNumber() && newData.val() >= -2048 && newData.val() <= 1000000000"
            },
            "raid": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
            },
            "$other": {
              ".validate": false
            }
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "chat": {
      "$world": {
        ".read": "auth != null",
        ".indexOn": ["t"],
        ".validate": "$world === 'satisfy'",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('t').val() < now - 600000))",
          ".validate": "newData.hasChildren(['from', 'h', 'text', 't'])",
          "from": { ".validate": "newData.val() === auth.uid" },
          "h": { ".validate": "newData.isString() && newData.val() === root.child('accountIds').child(auth.uid).val()" },
          "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120" },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "news": {
      "$world": {
        ".read": "auth != null",
        ".indexOn": ["t"],
        ".validate": "$world === 'satisfy'",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('t').val() < now - 600000))",
          ".validate": "newData.hasChildren(['from', 'h', 'k', 't'])",
          "from": { ".validate": "newData.val() === auth.uid" },
          "h": { ".validate": "newData.isString() && newData.val() === root.child('accountIds').child(auth.uid).val()" },
          "k": { ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z]{2,16}$/)" },
          "p": {
            "$f": { ".validate": "($f === 'lv' || $f === 'f' || $f === 'rk') && newData.isNumber()" }
          },
          "t": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },
    "handles": {
      "$h": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()))",
        ".validate": "$h.matches(/^[a-z0-9_]{3,16}$/)"
      }
    },
    "accountIds": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid && (!data.exists() || !newData.exists())",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{3,16}$/) && root.child('handles').child(newData.val().toLowerCase()).val() === $uid"
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['handle', 'look', 'language', 'titleId', 'classId', 'lv', 'revision', 't']) && (!data.exists() || newData.child('revision').val() > data.child('revision').val())",
        "handle": {
          ".validate": "newData.isString() && newData.val().length <= 24"
        },
        "look": {
          ".validate": "newData.hasChildren(['hair', 'hc', 'skin', 'top'])",
          "$f": {
            ".validate": "($f === 'hair' || $f === 'hc' || $f === 'skin' || $f === 'top') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 31"
          }
        },
        "language": {
          ".validate": "newData.val() === 'ar' || newData.val() === 'en'"
        },
        "titleId": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "classId": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "lv": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
        },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "cloudIndex": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$pid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$pid.matches(/^[a-z0-9_]{4,40}$/) && newData.hasChildren(['pid', 'handle', 'lv', 'cls', 'schema', 'savedAt', 'rev', 'size', 't'])",
          "pid": {
            ".validate": "newData.val() === $pid"
          },
          "handle": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "lv": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },
          "cls": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "schema": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 99"
          },
          "savedAt": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "rev": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "size": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 400000"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "cloudSaves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$pid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$pid.matches(/^[a-z0-9_]{4,40}$/) && newData.hasChildren(['blob', 'rev', 't'])",
          "blob": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 400000"
          },
          "rev": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "sessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['sid', 't'])",
        "sid": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
