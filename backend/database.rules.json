{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$world": {
        ".validate": "$world === 'satisfy'",
        "$shard": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['v', 'uid', 'sid', 'handle', 'look', 'cls', 'lv', 'zone', 'x', 'y', 'dir', 'anim', 'arm', 'seq', 't'])",
            "v": { ".validate": "newData.val() === 1" },
            "uid": { ".validate": "newData.val() === $uid" },
            "sid": { ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64" },
            "handle": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "look": {
              ".validate": "newData.hasChildren(['hair', 'hc', 'skin', 'top'])",
              "$f": { ".validate": "($f === 'hair' || $f === 'hc' || $f === 'skin' || $f === 'top') && newData.isNumber() && newData.val() >= 0 && newData.val() <= 31" }
            },
            "cls": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "lv": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "zone": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "room": { ".validate": "newData.isString() && newData.val().length <= 16" },
            "x": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 2560" },
            "y": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 2304" },
            "dir": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "anim": { ".validate": "newData.isString() && newData.val().matches(/^(idle|walk|attack|dodge|dead)$/)" },
            "arm": { ".validate": "newData.val() === 0 || newData.val() === 1" },
            "party": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "seq": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "t": { ".validate": "newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
