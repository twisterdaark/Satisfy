      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['sid', 't'])",
        "sid": {
          ".validate": "newData.isString() && newData.val().length >= 8 && newData.val().length <= 64"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
